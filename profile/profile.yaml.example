# Your profile — the agent drafts only from what's here.
# Copy this file to profile.yaml and fill it in. Never invent experience:
# Explicit facts may be grouped below or kept in experience_bullets.
work_experience: [] # Each role: title, company, start_date, end_date, achievements.
projects: []
education: []
skills: []

name: "Your Name"
email: "you@example.com"
linkedin_url: "https://www.linkedin.com/in/your-handle/"

# Optional metadata for later: v0.1 does not read resumes or fetch LinkedIn.
# Path to your resume file (pdf or txt), relative to repo root.
resume_path: "profile/resume.pdf"

# The roles you're hunting. The agent searches for these.
target_roles:
  - "Forward Deployed Engineer"
  - "AI Engineer"

locations:
  - "Toronto, ON"
  - "Remote"

# Country scope for searches (including remote). Not a work-authorization claim.
search_country: "ca"

# Optional acceptable options. Empty means no preference; choose your own values.
# Examples: ["junior", "mid-level"], ["permanent"], ["remote", "hybrid"].
seniority_preferences: []
employment_preferences: []
work_arrangements: []

# Concrete experience bullets the agent may draw on when drafting.
# Keep each one to a single verifiable fact.
experience_bullets:
  - "Built ..."
  - "Shipped ..."

# Anything the agent should never claim or mention.
never_claim:
  - "Senior-level titles I haven't held"
